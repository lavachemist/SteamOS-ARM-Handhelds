From: lavachemist <48248311+lavachemist@users.noreply.github.com>
Subject: [PATCH] input: rsinput: quiesce the MCU and drop its supply across sleep

The RP6 controller MCU streams reports continuously. Reports arriving while
the GENI UART suspends make its IRQ handler return IRQ_NONE until the UART
IRQ is disabled as spurious, and the pad is dead until reboot. Drop the
enable/reset lines and the MCU supply at suspend; resume re-enables the
supply and re-initialises through rsinput_init_commands() (0508).

Combines Armada's 1005-input-rsinput-quiesce-the-mcu-across-system-sleep
and 1007-input-rsinput-drop-the-mcu-supply-across-system-sleep
(armada-os/armada, based on Luke Johnson's rsinput suspend patch). Written
against ROCKNIX's rsinput, which has no rsinput_suspend() or rumble work to
cancel, so Armada's hunks do not apply as they are.
---
--- a/drivers/input/joystick/rsinput.c
+++ b/drivers/input/joystick/rsinput.c
@@ -129,6 +129,7 @@
     struct input_dev *input;
     struct platform_device *platform_dev;
     struct regulator *vdd;
+    bool vdd_off;
     struct gpio_desc *boot_gpio;
     struct gpio_desc *enable_gpio;
     struct gpio_desc *reset_gpio;
@@ -623,17 +624,57 @@
     if (drv->reset_gpio)
         gpiod_set_value_cansleep(drv->reset_gpio, 0);
 
-    regulator_disable(drv->vdd);
+    if (!drv->vdd_off)
+        regulator_disable(drv->vdd);
+}
+
+static int rsinput_suspend(struct device *dev)
+{
+    struct rsinput_driver *drv = dev_get_drvdata(dev);
+    int error;
+
+    /*
+     * Stop continuous MCU reports before the UART suspends; otherwise the
+     * UART IRQ can be disabled as spurious. rsinput_resume() powers the
+     * MCU back on through rsinput_init_commands().
+     */
+    if (drv->enable_gpio)
+        gpiod_set_value_cansleep(drv->enable_gpio, 0);
+
+    if (drv->reset_gpio)
+        gpiod_set_value_cansleep(drv->reset_gpio, 0);
+
+    if (!drv->vdd_off) {
+        error = regulator_disable(drv->vdd);
+        if (error) {
+            dev_err(dev, "Failed to disable MCU supply: %d\n", error);
+            rsinput_init_commands(drv);
+            return error;
+        }
+        drv->vdd_off = true;
+    }
+
+    return 0;
 }
 
 static int rsinput_resume(struct device *dev)
 {
     struct rsinput_driver *drv = dev_get_drvdata(dev);
+    int error;
+
+    if (drv->vdd_off) {
+        error = regulator_enable(drv->vdd);
+        if (error) {
+            dev_err(dev, "Failed to enable MCU supply: %d\n", error);
+            return error;
+        }
+        drv->vdd_off = false;
+    }
 
     return rsinput_init_commands(drv);
 }
 
-static DEFINE_SIMPLE_DEV_PM_OPS(rsinput_pm_ops, NULL, rsinput_resume);
+static DEFINE_SIMPLE_DEV_PM_OPS(rsinput_pm_ops, rsinput_suspend, rsinput_resume);
 
 static const struct of_device_id rsinput_of_match[] = {
     { .compatible = "gamepad,rsinput" },
