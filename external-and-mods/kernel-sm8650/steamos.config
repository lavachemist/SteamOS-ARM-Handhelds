# SteamOS additions on top of ROCKNIX devices/<SOC>/linux/linux.aarch64.conf
# (all SoCs; steamos-<soc>.config adds the SoC-specific ones).
# One CONFIG per line: =y, =m, =n or a value. build.sh reports any that
# Kconfig refuses.

# /etc and /var overlays are mounted early by SteamOS; don't depend on
# module autoload before /usr/lib/modules is reachable.
CONFIG_OVERLAY_FS=y

# InputPlumber deck-uhid needs the kernel hid-steam driver bound to the
# virtual Valve controller so Steam sees a real Deck pad.
CONFIG_HID_STEAM=m
CONFIG_STEAM_FF=y

# Proton / FEX: fast NT sync primitives (Wine ntsync)
CONFIG_NTSYNC=m

# Bluetooth HFP / controllers that use RFCOMM (ROCKNIX leaves it off)
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m

# Steam runtime / flatpak containers
CONFIG_EROFS_FS=m
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# systemd resource control that SteamOS units use
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_MISC=y

# zram is set up by SteamOS (zram-generator)
CONFIG_ZRAM=m
CONFIG_ZSWAP=y

# BPF JIT for systemd cgroup/IP filters
CONFIG_BPF_JIT_ALWAYS_ON=y

# SteamOS wifi uses iwd by default (the overlay pins wpa_supplicant, but keep iwd working)
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y

# LED pattern trigger: power-LED "breathing" feedback from konkr-controls
CONFIG_LEDS_TRIGGER_PATTERN=m

# Per-thread utilisation clamps: konkrd boosts game threads (uclamp.min) so
# schedutil ramps the big cores at once — Android's game-mode equivalent.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
# ROCKNIX defaults to `performance` on every core (A520s included).
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# Tracing filesystem (/sys/kernel/tracing). The Frame's userspace needs it:
# - mangoapp (Performance Overlay) reads Adreno busy/memory via tracefs and
#   aborts with "failed to create instance" without it;
# - steamos-manager -r exits EPERM trying to create /sys/kernel/tracing,
#   stalling Game Mode ~3 minutes while its D-Bus activation times out.
# ENABLE_DEFAULT_TRACERS gives tracefs + tracepoints without function
# instrumentation (no runtime cost).
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y

# Binder for Lepton (Valve's Android layer, Steam app 3029110). Lepton's
# container mounts binderfs itself and renames anbox-{binder,hwbinder,
# vndbinder}, so those must be binderfs's default devices. Same as the Frame
# kernel, which builds binder in.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="anbox-binder,anbox-hwbinder,anbox-vndbinder"
