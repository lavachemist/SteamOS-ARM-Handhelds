[Unit]
Description=AYN Thor: one brightness for both panels, bottom-screen switch
ConditionPathExists=/sys/class/backlight/ae96000.dsi.0
# Before Game Mode: Steam must open the bottom panel's brightness after this
# has put its own file over it.
Before=display-manager.service

[Service]
Type=simple
ExecCondition=/bin/sh -c 'grep -qa "ayn,thor" /sys/firmware/devicetree/base/compatible'
ExecStart=/usr/lib/steamos-sm8550/sm8550-thor-backlightd
Restart=always
RestartSec=2
# In case it died without undoing it.
ExecStopPost=-/bin/sh -c 'while mountpoint -q "$(realpath /sys/class/backlight/ae94000.dsi.0)/brightness"; do umount -l "$(realpath /sys/class/backlight/ae94000.dsi.0)/brightness" || break; done'

[Install]
WantedBy=multi-user.target
