[Unit]
Description=Detach the internal UFS when running from SD (SM8550 sleep fix)
ConditionPathExists=/sys/bus/platform/drivers/ufshcd-qcom
After=local-fs.target swap.target
Before=sleep.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecCondition=/bin/sh -c 'grep -qa "qcom,sm8550" /sys/firmware/devicetree/base/compatible'
ExecStart=/usr/lib/steamos-sm8550/sm8550-ufs-detach

[Install]
WantedBy=multi-user.target
