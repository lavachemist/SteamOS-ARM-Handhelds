[Unit]
Description=Barry Launcher: AYN Thor bottom-screen home, apps and keyboard in Desktop Mode
PartOf=graphical-session.target
After=plasma-plasmashell.service

[Service]
ExecCondition=/bin/sh -c 'grep -qa "ayn,thor" /sys/firmware/devicetree/base/compatible'
ExecStart=/usr/lib/barry_launcher/barry_launcher_desktop
Restart=on-failure
RestartSec=3

[Install]
WantedBy=plasma-workspace.target
