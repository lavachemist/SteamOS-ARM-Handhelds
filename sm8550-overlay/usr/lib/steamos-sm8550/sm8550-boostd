#!/usr/bin/env python3
"""sm8550-boostd — keep the game and the Steam UI on the big cores (SM8550).

SteamOS partitions the CPUs for the Steam Frame: the user session
(gamescope, Xwayland, Steam) runs on cpu0-4 (systemd user.conf) and games on
cpu3-7 (steam.service). On SM8550 cpu0-2 are the Cortex-A510s, so the
compositor and the Steam client share three little cores and two mid cores,
and with mainline EAS/schedutil the frame-critical threads also run at low
clocks. Android's game mode / WALT does what this does:

  game threads  (descendants of Steam's `reaper SteamLaunch`): uclamp.min 256
  UI threads    (gamescope, Xwayland, Steam, its webhelper, mangoapp,
                 InputPlumber): uclamp.min 200
  both          moved onto the big cores (cpu3-7) unless already pinned
                inside them (a game's own per-thread pins stay)

The uclamp.min values are konkrd's "balanced" profile (SM8650 overlay).
Measured on the Retroid Pocket 6 in Easy Delivery Co. (90 s runs, against
the mean of the runs before and after without it): 45.3 -> 49.2 fps average,
1 % low 25.6 -> 29.9 fps, frame-time SD 5.5 -> 4.3 ms, 5.1 -> 6.1 W.
Only narrowing the UI threads to the big cores they already had (cpu3-4)
did worse (1 % low 28.4, 7.0 W). Also measured and left out: GPU devfreq
polling 16 ms (1 % low -20 %), schedutil rate_limit_us 500 (+1 % fps, +0.3 W).

Stopping the service puts every thread it touched back (affinity, uclamp).
"""
from __future__ import annotations

import ctypes
import glob
import os
import signal
import sys
import time

TICK_S = 1
GAME_UCLAMP = 256
UI_UCLAMP = 200
UI_COMMS = {"gamescope-wl", "Xwayland", "steam", "steamwebhelper",
            "gamescopereaper", "mangoapp", "inputplumber"}


def log(msg: str) -> None:
    print(f"sm8550-boostd: {msg}", flush=True)


def rd(path: str, default: str = "") -> str:
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


class SchedAttr(ctypes.Structure):
    _fields_ = [("size", ctypes.c_uint32), ("sched_policy", ctypes.c_uint32),
                ("sched_flags", ctypes.c_uint64), ("sched_nice", ctypes.c_int32),
                ("sched_priority", ctypes.c_uint32), ("sched_runtime", ctypes.c_uint64),
                ("sched_deadline", ctypes.c_uint64), ("sched_period", ctypes.c_uint64),
                ("sched_util_min", ctypes.c_uint32), ("sched_util_max", ctypes.c_uint32)]


SYS_SCHED_SETATTR = 274  # aarch64
SCHED_FLAG_KEEP_ALL = 0x08 | 0x10
SCHED_FLAG_UTIL_CLAMP_MIN = 0x20
_libc = ctypes.CDLL(None, use_errno=True)


def set_uclamp_min(tid: int, value: int) -> bool:
    attr = SchedAttr(size=ctypes.sizeof(SchedAttr),
                     sched_flags=SCHED_FLAG_KEEP_ALL | SCHED_FLAG_UTIL_CLAMP_MIN,
                     sched_util_min=value)
    return _libc.syscall(SYS_SCHED_SETATTR, tid, ctypes.byref(attr), 0) == 0


def big_cpus() -> set[int]:
    """CPUs outside the lowest-capacity cluster (the A510s on SM8550)."""
    caps = {}
    for c in glob.glob("/sys/devices/system/cpu/cpu[0-9]*"):
        try:
            caps[int(os.path.basename(c)[3:])] = int(rd(f"{c}/cpu_capacity", "0"))
        except ValueError:
            pass
    if not caps:
        return set()
    low = min(caps.values())
    return {n for n, v in caps.items() if v > low}


def scan_procs() -> tuple[set[int], list[int]]:
    """One /proc pass: (game pids, UI pids). comm comes from stat; cmdline is
    read only for `reaper` (runs every second, so stay cheap)."""
    children: dict[int, list[int]] = {}
    roots, ui = [], []
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            with open(f"/proc/{p}/stat", "rb") as fh:
                stat = fh.read()
            r = stat.rfind(b")")
            comm = stat[stat.find(b"(") + 1:r].decode(errors="replace")
            ppid = int(stat[r + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            continue
        children.setdefault(ppid, []).append(int(p))
        if comm in UI_COMMS:
            ui.append(int(p))
        elif comm == "reaper":
            try:
                with open(f"/proc/{p}/cmdline", "rb") as fh:
                    if b"reaper\0SteamLaunch\0" in fh.read():
                        roots.append(int(p))
            except OSError:
                pass
    games, stack = set(), list(roots)
    while stack:
        for c in children.get(stack.pop(), ()):
            if c not in games:
                games.add(c)
                stack.append(c)
    return games, [u for u in ui if u not in games]


class Boost:
    def __init__(self) -> None:
        self.big = big_cpus()
        # tid -> original affinity (None when we left it alone)
        self.done: dict[int, set[int] | None] = {}

    def apply(self, tid: int, value: int) -> None:
        orig = None
        try:
            cur = os.sched_getaffinity(tid)
            if not cur <= self.big:
                os.sched_setaffinity(tid, self.big)
                orig = cur
        except OSError:
            return  # thread gone
        set_uclamp_min(tid, value)
        self.done[tid] = orig

    def tick(self) -> None:
        games, ui = scan_procs()
        live = set()
        for pids, value in ((games, GAME_UCLAMP), (ui, UI_UCLAMP)):
            for pid in pids:
                for t in glob.glob(f"/proc/{pid}/task/*"):
                    tid = int(os.path.basename(t))
                    live.add(tid)
                    if tid not in self.done:
                        self.apply(tid, value)
        for tid in [t for t in self.done if t not in live]:
            del self.done[tid]

    def undo(self) -> None:
        for tid, orig in self.done.items():
            try:
                if orig is not None:
                    os.sched_setaffinity(tid, orig)
                set_uclamp_min(tid, 0)
            except OSError:
                pass
        self.done.clear()


def main() -> int:
    boost = Boost()
    if not boost.big or len(boost.big) == os.cpu_count():
        log("no big/little split found, nothing to do")
        return 0
    log(f"big cores {sorted(boost.big)}; game uclamp.min {GAME_UCLAMP}, UI {UI_UCLAMP}")
    running = True

    def stop(*_):
        nonlocal running
        running = False
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    while running:
        boost.tick()
        time.sleep(TICK_S)
    boost.undo()
    log("stopped, threads restored")
    return 0


if __name__ == "__main__":
    sys.exit(main())
