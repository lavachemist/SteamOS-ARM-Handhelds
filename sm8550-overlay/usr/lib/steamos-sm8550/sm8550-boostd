#!/usr/bin/env python3
"""sm8550-boostd — uclamp boost for the game and the Steam UI (SM8550).

With mainline EAS/schedutil the frame-critical threads run at low clocks and
land on the Cortex-A510s (cpu0-2). Android's game mode / WALT raises their
utilization floor; this does the same:

  game threads  (descendants of Steam's `reaper SteamLaunch`): uclamp.min 256
  UI threads    (gamescope, Xwayland, Steam, its webhelper, mangoapp,
                 InputPlumber): uclamp.min 200

No CPU affinity is set: the floor makes EAS pick a core with room and raises
schedutil's clock, but placement stays the scheduler's. (An earlier version
also moved these threads onto cpu3-7; the image no longer hard-pins games,
see 70-sm8550-cpu-affinity.conf.)

The uclamp.min values are konkrd's "balanced" profile (SM8650 overlay).
Measured on the Retroid Pocket 6 in Easy Delivery Co. with the old big-core
pin included (90 s runs, against the mean of the runs before and after
without it): 45.3 -> 49.2 fps average, 1 % low 25.6 -> 29.9 fps, frame-time
SD 5.5 -> 4.3 ms, 5.1 -> 6.1 W. Also measured and left out: GPU devfreq
polling 16 ms (1 % low -20 %), schedutil rate_limit_us 500 (+1 % fps, +0.3 W).

The image defaults to EAS. If a sched_ext scheduler is picked anyway
(steamosctl set-cpu-scheduler lavd), this stands aside and clears the
floors, since sched_ext ignores uclamp. It takes over again when the
scheduler is switched back to the kernel default.

Stopping the service clears every floor it set.
"""
from __future__ import annotations

import ctypes
import glob
import os
import signal
import sys
import time

TICK_S = 1
GAME_UCLAMP = 256
UI_UCLAMP = 200
UI_COMMS = {"gamescope-wl", "Xwayland", "steam", "steamwebhelper",
            "gamescopereaper", "mangoapp", "inputplumber"}


def log(msg: str) -> None:
    print(f"sm8550-boostd: {msg}", flush=True)


def rd(path: str, default: str = "") -> str:
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


class SchedAttr(ctypes.Structure):
    _fields_ = [("size", ctypes.c_uint32), ("sched_policy", ctypes.c_uint32),
                ("sched_flags", ctypes.c_uint64), ("sched_nice", ctypes.c_int32),
                ("sched_priority", ctypes.c_uint32), ("sched_runtime", ctypes.c_uint64),
                ("sched_deadline", ctypes.c_uint64), ("sched_period", ctypes.c_uint64),
                ("sched_util_min", ctypes.c_uint32), ("sched_util_max", ctypes.c_uint32)]


SYS_SCHED_SETATTR = 274  # aarch64
SCHED_FLAG_KEEP_ALL = 0x08 | 0x10
SCHED_FLAG_UTIL_CLAMP_MIN = 0x20
_libc = ctypes.CDLL(None, use_errno=True)


def set_uclamp_min(tid: int, value: int) -> bool:
    attr = SchedAttr(size=ctypes.sizeof(SchedAttr),
                     sched_flags=SCHED_FLAG_KEEP_ALL | SCHED_FLAG_UTIL_CLAMP_MIN,
                     sched_util_min=value)
    return _libc.syscall(SYS_SCHED_SETATTR, tid, ctypes.byref(attr), 0) == 0


def scan_procs() -> tuple[set[int], list[int]]:
    """One /proc pass: (game pids, UI pids). comm comes from stat; cmdline is
    read only for `reaper` (runs every second, so stay cheap)."""
    children: dict[int, list[int]] = {}
    roots, ui = [], []
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            with open(f"/proc/{p}/stat", "rb") as fh:
                stat = fh.read()
            r = stat.rfind(b")")
            comm = stat[stat.find(b"(") + 1:r].decode(errors="replace")
            ppid = int(stat[r + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            continue
        children.setdefault(ppid, []).append(int(p))
        if comm in UI_COMMS:
            ui.append(int(p))
        elif comm == "reaper":
            try:
                with open(f"/proc/{p}/cmdline", "rb") as fh:
                    if b"reaper\0SteamLaunch\0" in fh.read():
                        roots.append(int(p))
            except OSError:
                pass
    games, stack = set(), list(roots)
    while stack:
        for c in children.get(stack.pop(), ()):
            if c not in games:
                games.add(c)
                stack.append(c)
    return games, [u for u in ui if u not in games]


class Boost:
    def __init__(self) -> None:
        self.done: set[int] = set()

    def tick(self) -> None:
        games, ui = scan_procs()
        live = set()
        for pids, value in ((games, GAME_UCLAMP), (ui, UI_UCLAMP)):
            for pid in pids:
                for t in glob.glob(f"/proc/{pid}/task/*"):
                    tid = int(os.path.basename(t))
                    live.add(tid)
                    if tid not in self.done and set_uclamp_min(tid, value):
                        self.done.add(tid)
        self.done &= live

    def undo(self) -> None:
        for tid in self.done:
            set_uclamp_min(tid, 0)
        self.done.clear()


def scx_active() -> bool:
    """A sched_ext scheduler (e.g. scx_lavd) is running. It ignores uclamp
    and does its own placement (LAVD + boost measured slightly worse than
    LAVD alone)."""
    return rd("/sys/kernel/sched_ext/state") == "enabled"


def main() -> int:
    boost = Boost()
    log(f"game uclamp.min {GAME_UCLAMP}, UI {UI_UCLAMP}, no affinity changes")
    running = True

    def stop(*_):
        nonlocal running
        running = False
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    yielded = False
    while running:
        if scx_active():
            if not yielded:
                boost.undo()
                log("sched_ext scheduler active, standing aside")
                yielded = True
        else:
            if yielded:
                log("sched_ext scheduler gone, boosting again")
                yielded = False
            boost.tick()
        time.sleep(TICK_S)
    boost.undo()
    log("stopped, uclamp floors cleared")
    return 0


if __name__ == "__main__":
    sys.exit(main())
