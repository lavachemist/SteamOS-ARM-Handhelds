#!/bin/bash
# sm8550-bottom-session: what runs on the AYN Thor's bottom screen during
# Game Mode, inside the nested gamescope that sm8550-run-bottom starts on the
# lease. The bottom screen is a general space: apps meant to live there are
# started here, over bottom-home, the black base window that keeps the screen
# from freezing on an overlay's last frame. thor-dashboard runs hidden and
# raises itself over them when the AYN button asks (gamescope shows the most
# recently shown window). X11 clients, so gamescope's stacking applies.
export QT_QPA_PLATFORM=xcb QT_XCB_GL_INTEGRATION=xcb_egl
/usr/lib/steamos-sm8550/thor-statsd &
qml6 /usr/share/steamos-sm8550/bottom-home.qml &
sleep 1  # home first, so it stays at the bottom
/usr/lib/steamos-sm8550/thor-dashboard &
wait
