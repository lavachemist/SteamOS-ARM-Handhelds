#!/usr/bin/env python3
"""sm8550-thor-backlightd: AYN Thor, one brightness for both panels, and the
bottom-screen switch.

Steam's Game Mode brightness slider adjusts the first backlight it finds, the
bottom panel's (ae94000.dsi.0), and writes it directly (the video group may).
Game Mode shows the top panel (ae96000.dsi.0). This follows every change of
the bottom backlight and sets the top one to the same fraction of its range
straight away. (A steamos-priv-write redirect alone ran pkexec for every
slider step and lagged; it stays as a fallback.)

The Dual Screen Decky plugin writes "off" or "on" to STATE. While it is
"off" the bottom panel's backlight is powered down (bl_power; the brightness
Steam sets is kept underneath, so the top panel still follows) and its
touchscreen is inhibited. Both are enforced on every pass, because the panel
driver powers the backlight up again on each modeset and wake, and the Game
Mode / Desktop start scripts re-enable the touchscreen. Switching back to
"on" powers the backlight up at the top panel's brightness and re-enables
touch.
"""
from __future__ import annotations

import glob
import os
import select
import sys

BOTTOM = "/sys/class/backlight/ae94000.dsi.0"
TOP = "/sys/class/backlight/ae96000.dsi.0"
STATE = "/var/lib/steamos-sm8550/thor-bottom-screen"
TOUCH_NAME = "bottom_touchscreen"
BL_ON, BL_OFF = "0", "4"  # FB_BLANK_UNBLANK, FB_BLANK_POWERDOWN
# The kernel notifies actual_brightness on changes; the timeout also paces
# enforcing the switch.
POLL_MS = 100


def read(path: str, default: str = "") -> str:
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return default


def write(path: str, value: str) -> None:
    try:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(value)
    except OSError as err:
        print(f"cannot write {value} to {path}: {err}", file=sys.stderr, flush=True)


def touch_inhibited_paths() -> list[str]:
    return [
        f"{d}/inhibited"
        for d in glob.glob("/sys/class/input/input*")
        if read(f"{d}/name") == TOUCH_NAME
    ]


def bottom_off() -> bool:
    return read(STATE, "on") == "off"


def main() -> int:
    bottom_max = int(read(f"{BOTTOM}/max_brightness", "0") or 0)
    top_max = int(read(f"{TOP}/max_brightness", "0") or 0)
    if bottom_max <= 0 or top_max <= 0:
        print("no usable backlights", file=sys.stderr)
        return 1

    fd = os.open(f"{BOTTOM}/actual_brightness", os.O_RDONLY)

    def bottom_raw() -> int:
        os.lseek(fd, 0, os.SEEK_SET)
        return int(os.read(fd, 32).strip() or 0)

    def bottom_set() -> int:
        # actual_brightness reads 0 while bl_power is off; follow the value
        # Steam set instead.
        return int(read(f"{BOTTOM}/brightness", "0") or 0)

    poller = select.poll()
    poller.register(fd, select.POLLPRI | select.POLLERR)
    last = bottom_set()  # leave the top panel alone until something changes
    was_off = None
    print(f"following {BOTTOM} (max {bottom_max}) -> {TOP} (max {top_max})", flush=True)
    while True:
        poller.poll(POLL_MS)
        bottom_raw()  # consume the notification

        off = bottom_off()
        if off:
            if read(f"{BOTTOM}/bl_power") != BL_OFF:
                write(f"{BOTTOM}/bl_power", BL_OFF)
            for p in touch_inhibited_paths():
                if read(p) != "1":
                    write(p, "1")
        elif was_off:
            # Back on: match the top panel, then power up and allow touch.
            top_now = int(read(f"{TOP}/brightness", "0") or 0)
            match = max(1, min(bottom_max, round(top_now * bottom_max / top_max)))
            write(f"{BOTTOM}/brightness", str(match))
            last = match
            write(f"{BOTTOM}/bl_power", BL_ON)
            for p in touch_inhibited_paths():
                write(p, "0")
        if off != was_off:
            print(f"bottom screen {'off' if off else 'on'}", flush=True)
        was_off = off

        value = bottom_set()
        if value == last:
            continue
        last = value
        top = max(1, min(top_max, round(value * top_max / bottom_max)))
        write(f"{TOP}/brightness", str(top))


if __name__ == "__main__":
    sys.exit(main())
