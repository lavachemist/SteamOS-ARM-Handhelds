#!/usr/bin/env python3
"""sm8550-thor-backlightd: AYN Thor, copy the bottom panel's brightness to the top.

Steam's Game Mode brightness slider adjusts the first backlight it finds, the
bottom panel's (ae94000.dsi.0), and writes it directly (the video group may).
Game Mode shows the top panel (ae96000.dsi.0). This follows every change of
the bottom backlight and sets the top one to the same fraction of its range
straight away. (A steamos-priv-write redirect alone ran pkexec for every
slider step and lagged; it stays as a fallback.)

The Thor Screens Decky plugin sets one panel on its own: before it writes the
bottom panel it puts the raw value in SKIP, and that change is not copied.
"""
from __future__ import annotations

import os
import select
import sys

BOTTOM = "/sys/class/backlight/ae94000.dsi.0"
TOP = "/sys/class/backlight/ae96000.dsi.0"
SKIP = "/run/sm8550-thor-backlight/skip"
# The kernel notifies actual_brightness on changes; the timeout is a fallback.
POLL_MS = 100


def read_int(path: str) -> int:
    with open(path, encoding="utf-8") as fh:
        return int(fh.read().strip() or 0)


def take_skip() -> str | None:
    try:
        with open(SKIP, encoding="utf-8") as fh:
            value = fh.read().strip()
        os.unlink(SKIP)
        return value
    except OSError:
        return None


def main() -> int:
    bottom_max = read_int(f"{BOTTOM}/max_brightness")
    top_max = read_int(f"{TOP}/max_brightness")
    if bottom_max <= 0 or top_max <= 0:
        print("no usable backlights", file=sys.stderr)
        return 1
    os.makedirs(os.path.dirname(SKIP), exist_ok=True)

    fd = os.open(f"{BOTTOM}/actual_brightness", os.O_RDONLY)

    def current() -> int:
        os.lseek(fd, 0, os.SEEK_SET)
        return int(os.read(fd, 32).strip() or 0)

    poller = select.poll()
    poller.register(fd, select.POLLPRI | select.POLLERR)
    last = current()  # leave the top panel alone until something changes
    print(f"following {BOTTOM} (max {bottom_max}) -> {TOP} (max {top_max})", flush=True)
    while True:
        poller.poll(POLL_MS)
        value = current()
        if value == last:
            continue
        last = value
        if take_skip() == str(value):
            continue
        top = max(1, min(top_max, round(value * top_max / bottom_max)))
        try:
            with open(f"{TOP}/brightness", "w", encoding="utf-8") as fh:
                fh.write(str(top))
        except OSError as err:
            print(f"cannot set {TOP}: {err}", file=sys.stderr, flush=True)


if __name__ == "__main__":
    sys.exit(main())
