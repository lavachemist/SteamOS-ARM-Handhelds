#!/bin/bash
# sm8550-ufs-detach — unbind the internal UFS controller when SteamOS runs
# from the SD card (AYN Thor, Retroid Pocket 6).
#
# After a long s2idle sleep the UFS PHY can fail to re-calibrate on resume
# ("phy initialization timed-out"). The UFS device is then stuck in error and
# every later suspend aborts with -EBUSY, so the device never sleeps again
# until a reboot; the abort/resume loop has also hung the display. Nothing
# uses the internal storage when booted from SD (it holds Android), so take
# it out of the picture. A controller that holds a mounted filesystem or
# active swap is left alone (a future install to UFS).
set -u

drv=/sys/bus/platform/drivers/ufshcd-qcom
[[ -d "$drv" ]] || exit 0

# Block devices in use: mounted filesystems and active swap.
in_use_paths() {
  local src blk
  { findmnt -rno SOURCE; awk 'NR > 1 { print $1 }' /proc/swaps; } |
    while read -r src; do
      src="${src%%\[*}"
      [[ "$src" == /dev/* ]] || continue
      blk="$(basename "$(readlink -f "$src")")"
      readlink -f "/sys/class/block/$blk" 2>/dev/null
    done
}

for dev in "$drv"/*.ufshc; do
  [[ -e "$dev" ]] || continue
  name="$(basename "$dev")"
  real="$(readlink -f "$dev")"
  if in_use_paths | grep -q "^$real/"; then
    echo "$name holds a mounted filesystem or swap; leaving it attached"
    continue
  fi
  if echo "$name" >"$drv/unbind"; then
    echo "detached $name (SteamOS runs from the SD card)"
  else
    echo "could not detach $name" >&2
  fi
done
exit 0
