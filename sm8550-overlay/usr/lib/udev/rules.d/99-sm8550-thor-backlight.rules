# AYN Thor: Steam adjusts the first backlight it finds, the bottom panel's
# (ae94000.dsi.0). 60-gamescope-backlight.rules and the Frame image's
# 99-backlight.rules (written for the Frame's own ae94000 panel) make it
# writable by the video group, so Steam wrote it directly and Game Mode's
# brightness slider only changed the dark bottom panel. Keep the bottom panel
# root-only so Steam falls back to steamos-priv-write, which steers the write
# to the top panel (see priv-write-backlight.inc; Armada withholds the grant
# the same way). Named 99-sm8550-* so it runs after 99-backlight.rules.
ACTION=="add|change", SUBSYSTEM=="backlight", KERNEL=="ae94000.dsi.0", \
  PROGRAM="/bin/grep -qa ayn,thor /sys/firmware/devicetree/base/compatible", \
  RUN+="/bin/chmod 0644 /sys/class/backlight/%k/brightness"
