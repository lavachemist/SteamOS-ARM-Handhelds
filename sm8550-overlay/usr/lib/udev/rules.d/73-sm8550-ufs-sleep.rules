# SM8550: keep the UFS link in hibernate across system sleep (spm_lvl 3, the
# same state runtime PM already uses), instead of powering the device down
# with the link off (spm_lvl 5, the kernel default).
#
# After a long s2idle sleep the UFS PHY can fail to re-calibrate when the
# link is brought back from off ("phy initialization timed-out"). The device
# then stays in error and every later suspend aborts with -EBUSY (AYN Thor:
# 104 failed attempts in one boot; one aborted resume hung the display).
# Unbinding the controller instead hung the whole system, so don't. "bind":
# spm_lvl exists only once the driver is attached.
ACTION=="add|bind", SUBSYSTEM=="platform", DRIVER=="ufshcd-qcom", ATTR{spm_lvl}="3"
