# A new Firefox window puts the cursor in the address bar by itself; that
# should not bring up the keyboard as the app opens, nor when an app comes
# back (the tile tap that brought it is a touch too).
LAUNCH_QUIET_S = 3.0
SWITCH_QUIET_S = 1.5
# Text focus shows the keyboard only this soon after a touch.
TOUCH_NAME = "bottom_touchscreen"
TOUCH_S = 1.0
TAP_SLOP = 30  # touchscreen units a tap may wander
EV_KEY, EV_ABS, BTN_TOUCH = 1, 3, 0x14A
ABS_MT_POSITION_X, ABS_MT_POSITION_Y, ABS_MT_TRACKING_ID = 0x35, 0x36, 0x39
INPUT_EVENT = struct.Struct("llHHi")
# Launch-script dialogs (zenity) of Flatpak apps: watched this long.
DIALOG_CLASS = "^zenity$"
DIALOG_WATCH_S = 60.0
# Apps with "warm": read their files from the SD card into the page cache
# this long after we start, at idle I/O priority. A first start reads them
# cold (Signal: 25 s; 3-4 s once cached).
WARM_DELAY_S = 60.0
# Of the runtime, the libraries and fonts; of the profile, not the
# attachments (*.noindex, 1.9 GB for Signal).
WARM_RUNTIME_DIRS = ("lib/aarch64-linux-gnu", "lib/locale", "share/fonts")
KEYS = {"BackSpace", "Return", "Tab", "Left", "Right", "Up", "Down", "Escape", "Delete", "space"}


def log(msg: str) -> None:
    print(msg, flush=True)


class State:
    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.visible = False
        self.top = False
        self.apps: dict[str, subprocess.Popen] = {}
        self.status: dict[str, str] = {}  # app -> what its tile says meanwhile
        self.overlay_marked = False
        self.input_focus: bool | None = None
        self.quiet_until = 0.0  # monotonic time: no keyboard for text focus before it
        self.last_touch: float | None = None  # monotonic; None: no touchscreen found
        self.text_acc = None  # the focused editable field, if any

    def keyboard(self) -> dict:
        with self.lock:
            return {"visible": self.visible, "top": self.top}

    def set_keyboard(self, visible: bool, top: bool | None = None) -> None:
        if visible and dashboard_up():
            visible = False
        with self.lock:
            self.visible = visible
            if top is not None:
                self.top = top
        # Touches go to the keyboard only while it shows; it turns opaque
        # on its next poll (100 ms).
        keyboard_input_focus(visible)


STATE = State()


def dashboard_up() -> bool:
    try:
        with open(DASHBOARD_FLAG, encoding="utf-8") as fh:
            return fh.read().strip() == "1"
    except OSError:
        return False


def set_keyboard_prop(prop: str, value: str, quiet: bool = False) -> bool:
    r = subprocess.run(
        ["xprop", "-name", KEYBOARD_TITLE, "-f", prop, "32c", "-set", prop, value],
        capture_output=True, text=True,
    )
    if r.returncode != 0 and not quiet:
        log(f"cannot set {prop} on the keyboard: {r.stderr.strip()}")
    return r.returncode == 0


def mark_keyboard_overlay(quiet: bool = False) -> bool:
    """Make the (always mapped, transparent) keyboard window an overlay."""
    if not STATE.overlay_marked:
        if set_keyboard_prop("STEAM_INPUT_FOCUS", "0", quiet) and set_keyboard_prop("STEAM_OVERLAY", "1", quiet):
            STATE.overlay_marked = True
            STATE.input_focus = False
            log("keyboard marked as overlay")
    return STATE.overlay_marked


def keyboard_input_focus(on: bool) -> None:
    if STATE.input_focus == on or not mark_keyboard_overlay():
        return
    if set_keyboard_prop("STEAM_INPUT_FOCUS", "2" if on else "0"):
        STATE.input_focus = on


def write_firefox_prefs(profile: str, zoom: str, extra: dict) -> None:
    os.makedirs(profile, exist_ok=True)
    prefs = dict(FIREFOX_PREFS, **{"layout.css.devPixelsPerPx": zoom}, **extra)
    lines = [f"user_pref({json.dumps(k)}, {json.dumps(v)});" for k, v in prefs.items()]
    with open(f"{profile}/user.js", "w", encoding="utf-8") as fh:
        fh.write("// Written by barry_launcher_shelld at every start; change other settings in about:config.\n")
        fh.write("\n".join(lines) + "\n")


def running(app: str) -> subprocess.Popen | None:
    proc = STATE.apps.get(app)
    return proc if proc and proc.poll() is None else None


def activate(args: list[str]) -> bool:
    """Bring the first window matching xdotool search ARGS forward: map it
    again, so it is gamescope's most recently mapped window."""
    r = subprocess.run(["xdotool", "search", "--onlyvisible", *args], capture_output=True, text=True)
    wins = r.stdout.split()
    if not wins:
        return False
    r = subprocess.run(["xdotool", "windowunmap", "--sync", wins[0], "windowmap", "--sync", wins[0]],
                       capture_output=True, text=True)
    return r.returncode == 0


def go_home() -> None:
    STATE.set_keyboard(False)
    # The trackpad and keyboard are tools, not apps to come back to: leaving
    # them closes them. Their exit lets go of anything held on top (watch).
    for app, spec in APPS.items():
        if "qml" in spec and running(app):
            close(app)
    if not activate(["--name", f"^{HOME_TITLE}$"]):
        log("cannot find the home screen window")


def app_env(**extra: str) -> dict:
    env = dict(os.environ, GNOME_ACCESSIBILITY="1", **extra)
    env.pop("WAYLAND_DISPLAY", None)  # X11, where gamescope's stacking applies
    return env


def surface_dialogs(proc: subprocess.Popen) -> None:
    """Bring forward the dialogs a Flatpak's launch script opens before the
    app (Signal's asks about its password store on the first start, and
    quits on No): gamescope shows the most recently mapped window, so they
    would wait unseen behind the home screen."""
    shown: set[str] = set()
    deadline = time.monotonic() + DIALOG_WATCH_S
    while proc.poll() is None and time.monotonic() < deadline:
        r = subprocess.run(["xdotool", "search", "--onlyvisible", "--classname", DIALOG_CLASS],
                           capture_output=True, text=True)
        for win in r.stdout.split():
            if win not in shown:
                shown.add(win)
                subprocess.run(["xdotool", "windowunmap", "--sync", win, "windowmap", "--sync", win],
                               capture_output=True)
                log("brought a launch dialog forward")
        time.sleep(0.5)


def app_log(app: str):
    d = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "barry_launcher")
    os.makedirs(d, exist_ok=True)
    return open(os.path.join(d, f"{app}.log"), "w")


def flatpak_installed(ref: str) -> bool:
    return subprocess.run(["flatpak", "info", ref], capture_output=True).returncode == 0


def flatpak_location(ref: str) -> str | None:
    r = subprocess.run(["flatpak", "info", "--show-location", ref], capture_output=True, text=True)
    return r.stdout.strip() or None


def warm_apps() -> None:
    """Read the "warm" apps' files into the page cache, so their first start
    does not wait on the SD card. The kernel drops them again under memory
    pressure."""
    time.sleep(WARM_DELAY_S)
    for app, spec in APPS.items():
        if "warm" not in spec or running(app) or not flatpak_installed(spec["flatpak"]):
            continue
        ref = spec["flatpak"]
        paths = [os.path.expanduser(p) for p in spec["warm"]]
        loc = flatpak_location(ref)
        if loc:
            paths.append(os.path.join(loc, "files"))
        r = subprocess.run(["flatpak", "info", "--show-runtime", ref], capture_output=True, text=True)
        rt = flatpak_location(r.stdout.strip()) if r.stdout.strip() else None
        if rt:
            paths += [os.path.join(rt, "files", d) for d in WARM_RUNTIME_DIRS]
        paths = [p for p in paths if os.path.isdir(p)]
        started = time.monotonic()
        r = subprocess.run(
            ["ionice", "-c", "3", "nice", "-n", "19", "sh", "-c",
             'find "$@" -name "*.noindex" -prune -o -type f -print0 | xargs -0 -r cat | wc -c', "warm", *paths],
            capture_output=True, text=True,
        )
        size = int(r.stdout.strip() or 0)
        log(f"warmed {app}: {size // 1048576} MB in {time.monotonic() - started:.0f} s")


def start_flatpak(app: str, spec: dict) -> None:
    """Install the app from Flathub for this user if needed, then start it."""
    ref = spec["flatpak"]
    try:
        if not flatpak_installed(ref):
            STATE.status[app] = "Installing…"
            log(f"installing {ref} from Flathub")
            subprocess.run(["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", FLATHUB],
                           capture_output=True)
            r = subprocess.run(["flatpak", "install", "--user", "-y", "--noninteractive", "flathub", ref],
                               capture_output=True, text=True)
            if r.returncode != 0:
                log(f"cannot install {ref}: {r.stderr.strip()[-300:]}")
                return
        for path, text in spec.get("seed", {}).items():
            path = os.path.expanduser(path)
            if not os.path.exists(path):
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, "w", encoding="utf-8") as fh:
                    fh.write(text)
                log(f"wrote {path}")
        with app_log(app) as out:
            STATE.apps[app] = subprocess.Popen(
                ["flatpak", "run", ref, *spec.get("args", [])],
                env=app_env(ACCESSIBILITY_ENABLED="1"),
                stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
            )
        threading.Thread(target=surface_dialogs, args=(STATE.apps[app],), daemon=True).start()
        STATE.quiet_until = time.monotonic() + LAUNCH_QUIET_S
        log(f"started {app} (pid {STATE.apps[app].pid})")
    finally:
        STATE.status.pop(app, None)


def launch(app: str) -> tuple[int, dict]:
    spec = APPS.get(app)
    if spec is None:
        return 404, {"error": f"no app {app!r}"}
    if app in STATE.status:
        return 200, {"ok": True, "running": False}
    proc = running(app)
    if proc:
        STATE.quiet_until = time.monotonic() + SWITCH_QUIET_S
        if "flatpak" in spec:
            # Its window, or a launch dialog still waiting for an answer.
            if not activate(["--classname", spec["window"]]):
                activate(["--classname", DIALOG_CLASS])
        elif "qml" in spec or "qmlfile" in spec:
            activate(["--pid", str(proc.pid), "--name", spec["window"]])
        else:
            activate(["--pid", str(proc.pid), "--classname", "Navigator"])
        return 200, {"ok": True, "running": True}
    if "flatpak" in spec:
        STATE.status[app] = "Starting…"
        threading.Thread(target=start_flatpak, args=(app, spec), daemon=True).start()
        return 200, {"ok": True, "running": False}
    if "qml" in spec or "qmlfile" in spec:
        cmd = (["qml6", TOP_INPUT_QML, "--", spec["qml"]] if "qml" in spec
               else ["qml6", os.path.join(SHELL_DIR, spec["qmlfile"])])
        STATE.apps[app] = subprocess.Popen(
            cmd,
            env=app_env(),
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        log(f"started {app} (pid {STATE.apps[app].pid})")
        return 200, {"ok": True, "running": False}
    profile = os.path.join(DATA, spec["profile"])
    write_firefox_prefs(profile, spec["zoom"], spec.get("prefs", {}))
    # Start clean: a session left by a killed instance makes Firefox offer
    # "Open previous tabs?", which a kiosk app cannot act on.
    for leftover in ("sessionstore.jsonlz4", "sessionstore-backups"):
        path = os.path.join(profile, leftover)
        if os.path.isdir(path):
            shutil.rmtree(path, ignore_errors=True)
        elif os.path.exists(path):
            os.remove(path)
    STATE.apps[app] = subprocess.Popen(
        ["firefox", "--no-remote", "--profile", profile, *spec["args"]],
        env=app_env(MOZ_USE_XINPUT2="1", MOZ_ENABLE_WAYLAND="0"),
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    STATE.quiet_until = time.monotonic() + LAUNCH_QUIET_S
    log(f"started {app} (pid {STATE.apps[app].pid})")
    return 200, {"ok": True, "running": False}


def close(app: str) -> tuple[int, dict]:
    if app not in APPS:
        return 404, {"error": f"no app {app!r}"}
    proc = running(app)
    if proc:
        if "flatpak" in APPS[app]:
            # The app runs in flatpak's sandbox, not as our child.
            subprocess.run(["flatpak", "kill", APPS[app]["flatpak"]], capture_output=True)
        else:
            proc.terminate()
        log(f"closing {app}")
    return 200, {"ok": True}


def release_top_input() -> None:
    """Let go of anything the trackpad or keyboard held on the top screen."""
    req = urllib.request.Request(f"{INPUTD}/release", b"{}", {"Content-Type": "application/json"})
    try:
        urllib.request.urlopen(req, timeout=1).close()
    except OSError:
        pass


def type_input(body: dict) -> tuple[int, dict]:
    if isinstance(body.get("text"), str) and body["text"]:
        cmd = ["xdotool", "type", "--delay", "0", "--", body["text"]]
    elif body.get("key") in KEYS:
        cmd = ["xdotool", "key", "--", body["key"]]
    else:
        return 400, {"error": "need text or a known key"}
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        return 500, {"error": r.stderr.strip()}
    return 200, {"ok": True}


class Handler(BaseHTTPRequestHandler):
    def _json(self, code: int, obj) -> None:
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _body(self) -> dict:
        try:
            n = int(self.headers.get("Content-Length", "0"))
            data = json.loads(self.rfile.read(n) if 0 < n <= 4096 else b"{}")
            return data if isinstance(data, dict) else {}
        except ValueError:
            return {}

    def do_GET(self) -> None:
        path = self.path.split("?", 1)[0]
        if path == "/keyboard":
            self._json(200, STATE.keyboard())
        elif path == "/apps":
            self._json(200, {name: {"running": running(name) is not None,
                                    "status": STATE.status.get(name, "")} for name in APPS})
        else:
            self._json(404, {"error": "not found"})

    def _local(self) -> bool:
        return (self.headers.get("Host", "") in (f"127.0.0.1:{PORT}", f"localhost:{PORT}")
                and self.headers.get("Origin") is None
                and self.headers.get("Content-Type", "").split(";")[0].strip() == "application/json")

    def do_POST(self) -> None:
        path = self.path.split("?", 1)[0]
        body = self._body()
        if not self._local():
            self._json(403, {"error": "local JSON requests only"})
        elif path == "/launch":
            self._json(*launch(str(body.get("app", ""))))
        elif path == "/close":
            self._json(*close(str(body.get("app", ""))))
        elif path == "/home":
            go_home()
            self._json(200, {"ok": True})
        elif path == "/keyboard":
            STATE.set_keyboard(bool(body.get("visible")))
            self._json(200, STATE.keyboard())
        elif path == "/type":
            self._json(*type_input(body))
        else:
            self._json(404, {"error": "not found"})

    def log_message(self, *_args) -> None:
        pass


def enable_accessibility() -> None:
    """Tell apps an assistive technology is listening (like GNOME's switch)."""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        bus.call_sync(
            "org.a11y.Bus", "/org/a11y/bus", "org.freedesktop.DBus.Properties", "Set",
            GLib.Variant("(ssv)", ("org.a11y.Status", "IsEnabled", GLib.Variant("b", True))),
            None, Gio.DBusCallFlags.NONE, 2000, None,
        )
    except GLib.Error as err:
        log(f"cannot enable accessibility: {err.message}")


def watch_touches() -> None:
    """Note when a finger touches the bottom screen. Reading an evdev node
    does not take its events away from gamescope."""
    for name_file in glob.glob("/sys/class/input/event*/device/name"):
        try:
            with open(name_file, encoding="utf-8") as fh:
                if fh.read().strip() != TOUCH_NAME:
                    continue
        except OSError:
            continue
        dev = "/dev/input/" + name_file.split("/")[4]
        try:
            fd = os.open(dev, os.O_RDONLY)
        except OSError as err:
            log(f"cannot read {dev} ({TOUCH_NAME}): {err}; the keyboard follows focus alone")
            return
        STATE.last_touch = 0.0
        log(f"watching touches on {dev}")
        fingers = 0
        x = y = start = None  # the first finger of a one-finger touch
        with os.fdopen(fd, "rb", buffering=0) as fh:
            while True:
                data = fh.read(INPUT_EVENT.size)
                if len(data) < INPUT_EVENT.size:
                    return
                _, _, etype, code, value = INPUT_EVENT.unpack(data)
                if (etype == EV_KEY and code == BTN_TOUCH) or (etype == EV_ABS and code == ABS_MT_TRACKING_ID):
                    STATE.last_touch = time.monotonic()
                if etype != EV_ABS:
                    continue
                if code == ABS_MT_TRACKING_ID:
                    if value >= 0:
                        fingers += 1
                        x = y = start = None
                    else:
                        fingers = max(0, fingers - 1)
                        if fingers == 0 and start and x is not None and abs(x - start[0]) + abs(y - start[1]) < TAP_SLOP:
                            GLib.idle_add(on_tap, x, y)
                        start = None
                elif fingers == 1 and code in (ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
                    if code == ABS_MT_POSITION_X:
                        x = value
                    else:
                        y = value
                    if start is None and x is not None and y is not None:
                        start = (x, y)
    log(f"no {TOUCH_NAME} input device; the keyboard follows focus alone")


def text_field(acc) -> tuple[bool, bool]:
    """(editable, in the lower half of the screen) for an accessible."""
    states = acc.get_state_set()
    editable = states.contains(Atspi.StateType.EDITABLE) and not states.contains(Atspi.StateType.READ_ONLY)
    top = False
    if editable:
        ext = acc.get_extents(Atspi.CoordType.SCREEN)
        screen_h = int(os.environ.get("THOR_BOTTOM_HEIGHT", "1080"))
        top = ext.y + ext.height / 2 > screen_h * 0.5
    return editable, top


def touched_lately() -> bool:
    return STATE.last_touch is None or time.monotonic() - STATE.last_touch < TOUCH_S


def show_for_text(top: bool, why: str) -> None:
    if time.monotonic() < STATE.quiet_until:
        log(f"{why} while an app opens: no keyboard")
        return
    if not touched_lately():
        log(f"{why} without a touch: no keyboard")
        return
    if not STATE.keyboard()["visible"] or top != STATE.keyboard()["top"]:
        log(f"{why}{' (lower half)' if top else ''}: keyboard")
    STATE.set_keyboard(True, top)


def on_focus(event) -> None:
    if event.detail1 != 1:
        return  # the next focus gain decides
    try:
        editable, top = text_field(event.source)
    except GLib.Error:
        return
    if editable:
        STATE.text_acc = event.source
        show_for_text(top, "text focus in")
        return
    STATE.text_acc = None
    if STATE.keyboard()["visible"]:
        log("text focus out")
    STATE.set_keyboard(False)


def on_caret(event) -> None:
    """A tap in a field that already has focus moves only its caret."""
    if STATE.keyboard()["visible"]:
        return
    try:
        acc = event.source
        if not acc.get_state_set().contains(Atspi.StateType.FOCUSED):
            return
        editable, top = text_field(acc)
    except GLib.Error:
        return
    if editable:
        STATE.text_acc = acc
    if editable and touched_lately():  # apps move their own carets all the time
        show_for_text(top, "caret moved in a focused field")


def on_tap(raw_x: int, raw_y: int) -> bool:
    """A one-finger tap ended: on the focused field with the keyboard
    hidden (by hand, say), show it again."""
    acc = STATE.text_acc
    if acc is None or STATE.keyboard()["visible"]:
        return False
    # The panel is portrait and turned right: its y runs left to right on
    # screen, its x bottom to top.
    screen_h = int(os.environ.get("THOR_BOTTOM_HEIGHT", "1080"))
    sx, sy = raw_y, screen_h - 1 - raw_x
    try:
        if not acc.get_state_set().contains(Atspi.StateType.FOCUSED):
            return False
        editable, top = text_field(acc)
        ext = acc.get_extents(Atspi.CoordType.SCREEN)
    except GLib.Error:
        return False
    if editable and ext.x <= sx < ext.x + ext.width and ext.y <= sy < ext.y + ext.height:
        show_for_text(top, "tap on the focused field")
    return False


def main() -> None:
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    enable_accessibility()
    Atspi.init()
    listener = Atspi.EventListener.new(on_focus)
    listener.register("object:state-changed:focused")
    caret = Atspi.EventListener.new(on_caret)
    caret.register("object:text-caret-moved")
    threading.Thread(target=watch_touches, daemon=True).start()
    threading.Thread(target=warm_apps, daemon=True).start()
    def home_request_stamp() -> int | None:
        try:
            return os.stat(HOME_REQUEST).st_mtime_ns
        except OSError:
            return None

    last_home = home_request_stamp()

    def watch() -> bool:
        nonlocal last_home
        # The keyboard window appears shortly after we start; mark it then,
        # so gamescope does not take it for an app.
        if not STATE.overlay_marked:
            mark_keyboard_overlay(quiet=True)
        # An app ending means its fields are gone too.
        for name, proc in list(STATE.apps.items()):
            if proc.poll() is not None:
                log(f"{name} exited")
                del STATE.apps[name]
                if "qml" in APPS[name]:
                    threading.Thread(target=release_top_input, daemon=True).start()
                STATE.set_keyboard(False)
        # AYN held: home.
        stamp = home_request_stamp()
        if stamp != last_home:
            last_home = stamp
            if stamp is not None:
                go_home()
        # Overlays draw above the dashboard: step aside while it is up.
        if STATE.keyboard()["visible"] and dashboard_up():
            STATE.set_keyboard(False)
        return True
    GLib.timeout_add(200, watch)
    Atspi.event_main()


if __name__ == "__main__":
    main()
