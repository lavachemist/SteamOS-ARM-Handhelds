#!/usr/bin/env python3
"""barry_launcher_shelld: Barry Launcher's apps and on-screen keyboard for
the AYN Thor's bottom screen.

Runs in barry_launcher_session next to the shell (shell/Shell.qml) and the
keyboard (shell/Keyboard.qml), which call it on 127.0.0.1:PORT:

  GET  /apps      {"browser": {"running": bool}, "discord": {...}}
  POST /launch    {"app": name}: start the app, or bring the running one
                  forward
  POST /close     {"app": name}: quit it
  POST /home      bring the home screen forward
  GET  /keyboard  {"visible": bool, "top": bool}: top when the text field is
                  in the lower half, so the keyboard does not cover it
  POST /keyboard  {"visible": bool}: show or hide by hand
  POST /type      {"text": "..."} or {"key": "BackSpace"|"Return"|...}

The keyboard follows text focus through AT-SPI: Firefox reports focus
changes on the accessibility bus, and an editable field gaining focus shows
the keyboard; anything else gaining focus hides it. Keys go to the focused
window through XTest (xdotool). The keyboard window is a gamescope overlay
(STEAM_OVERLAY), and while shown it has STEAM_INPUT_FOCUS=2, as Steam's own
keyboard does: it takes the touches, but X keyboard focus stays on the app
underneath. Like Steam's overlay it stays mapped and hides by opacity:
gamescope stops watching a window's properties once it is unmapped, so a
hidden overlay's marks could never be cleared. It also hides while the AYN
dashboard is up, since overlays are drawn above it.

Apps are Firefox instances, each with its own profile under
~/.local/share/barry_launcher: the browser, and Discord's web app in kiosk
mode (no address bar or tabs). Without Steam, gamescope treats every window
as its own app and shows the most recently mapped one (stacking order does
not count), so switching is unmapping and mapping the wanted window again.
Holding the AYN button (sm8550-thor-backlightd) writes HOME_REQUEST, and any
change to it brings the home screen forward.
"""
from __future__ import annotations

import json
import os
import subprocess
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import gi

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi, Gio, GLib  # noqa: E402

PORT = 47824
KEYBOARD_TITLE = "Barry Launcher Keyboard"
HOME_TITLE = "Barry Launcher"
DASHBOARD_FLAG = "/run/sm8550-thor/overlay"
HOME_REQUEST = "/run/sm8550-thor/home"
HOME = os.path.expanduser("~")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME", f"{HOME}/.local/share"), "barry_launcher")
# name -> Firefox profile folder, extra arguments, zoom. The panel is about
# 420 pixels per inch: 2.5 gives phone-sized pages; Discord's site has no
# phone layout (it sends phones to the app), so it gets its desktop layout,
# which needs about 1000 CSS pixels across.
APPS = {
    "browser": {"profile": "browser", "args": [], "zoom": "2.5"},
    "discord": {"profile": "discord", "args": ["--kiosk", "https://discord.com/app"], "zoom": "1.25"},
}
FIREFOX_PREFS = {
    "browser.shell.checkDefaultBrowser": False,
    "browser.aboutwelcome.enabled": False,
    "browser.startup.homepage_override.mstone": "ignore",
    "trailhead.firstrun.didSeeAboutWelcome": True,
    "datareporting.policy.dataSubmissionPolicyBypassNotification": True,
    "browser.tabs.warnOnClose": False,
    "browser.tabs.closeWindowWithLastTab": True,
    "browser.sessionstore.resume_from_crash": False,
    "dom.w3c_touch_events.enabled": 1,
    "apz.allow_zooming": True,
    "ui.osk.enabled": False,
    "accessibility.force_disabled": 0,
    "media.autoplay.default": 1,
}
KEYS = {"BackSpace", "Return", "Tab", "Left", "Right", "Up", "Down", "Escape", "Delete", "space"}


def log(msg: str) -> None:
    print(msg, flush=True)


class State:
    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.visible = False
        self.top = False
        self.apps: dict[str, subprocess.Popen] = {}
        self.overlay_marked = False
        self.input_focus: bool | None = None

    def keyboard(self) -> dict:
        with self.lock:
            return {"visible": self.visible, "top": self.top}

    def set_keyboard(self, visible: bool, top: bool | None = None) -> None:
        if visible and dashboard_up():
            visible = False
        with self.lock:
            self.visible = visible
            if top is not None:
                self.top = top
        # Touches go to the keyboard only while it shows; it turns opaque
        # on its next poll (100 ms).
        keyboard_input_focus(visible)


STATE = State()


def dashboard_up() -> bool:
    try:
        with open(DASHBOARD_FLAG, encoding="utf-8") as fh:
            return fh.read().strip() == "1"
    except OSError:
        return False


def set_keyboard_prop(prop: str, value: str, quiet: bool = False) -> bool:
    r = subprocess.run(
        ["xprop", "-name", KEYBOARD_TITLE, "-f", prop, "32c", "-set", prop, value],
        capture_output=True, text=True,
    )
    if r.returncode != 0 and not quiet:
        log(f"cannot set {prop} on the keyboard: {r.stderr.strip()}")
    return r.returncode == 0


def mark_keyboard_overlay(quiet: bool = False) -> bool:
    """Make the (always mapped, transparent) keyboard window an overlay."""
    if not STATE.overlay_marked:
        if set_keyboard_prop("STEAM_INPUT_FOCUS", "0", quiet) and set_keyboard_prop("STEAM_OVERLAY", "1", quiet):
            STATE.overlay_marked = True
            STATE.input_focus = False
            log("keyboard marked as overlay")
    return STATE.overlay_marked


def keyboard_input_focus(on: bool) -> None:
    if STATE.input_focus == on or not mark_keyboard_overlay():
        return
    if set_keyboard_prop("STEAM_INPUT_FOCUS", "2" if on else "0"):
        STATE.input_focus = on


def write_firefox_prefs(profile: str, zoom: str) -> None:
    os.makedirs(profile, exist_ok=True)
    prefs = dict(FIREFOX_PREFS, **{"layout.css.devPixelsPerPx": zoom})
    lines = [f"user_pref({json.dumps(k)}, {json.dumps(v)});" for k, v in prefs.items()]
    with open(f"{profile}/user.js", "w", encoding="utf-8") as fh:
        fh.write("// Written by barry_launcher_shelld at every start; change other settings in about:config.\n")
        fh.write("\n".join(lines) + "\n")


def running(app: str) -> subprocess.Popen | None:
    proc = STATE.apps.get(app)
    return proc if proc and proc.poll() is None else None


def activate(args: list[str]) -> bool:
    """Bring the first window matching xdotool search ARGS forward: map it
    again, so it is gamescope's most recently mapped window."""
    r = subprocess.run(["xdotool", "search", "--onlyvisible", *args], capture_output=True, text=True)
    wins = r.stdout.split()
    if not wins:
        return False
    r = subprocess.run(["xdotool", "windowunmap", "--sync", wins[0], "windowmap", "--sync", wins[0]],
                       capture_output=True, text=True)
    return r.returncode == 0


def go_home() -> None:
    STATE.set_keyboard(False)
    if not activate(["--name", f"^{HOME_TITLE}$"]):
        log("cannot find the home screen window")


def launch(app: str) -> tuple[int, dict]:
    spec = APPS.get(app)
    if spec is None:
        return 404, {"error": f"no app {app!r}"}
    proc = running(app)
    if proc:
        activate(["--pid", str(proc.pid), "--classname", "Navigator"])
        return 200, {"ok": True, "running": True}
    profile = os.path.join(DATA, spec["profile"])
    write_firefox_prefs(profile, spec["zoom"])
    env = dict(os.environ, MOZ_USE_XINPUT2="1", MOZ_ENABLE_WAYLAND="0", GNOME_ACCESSIBILITY="1")
    env.pop("WAYLAND_DISPLAY", None)
    STATE.apps[app] = subprocess.Popen(
        ["firefox", "--no-remote", "--profile", profile, *spec["args"]],
        env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    log(f"started {app} (pid {STATE.apps[app].pid})")
    return 200, {"ok": True, "running": False}


def close(app: str) -> tuple[int, dict]:
    if app not in APPS:
        return 404, {"error": f"no app {app!r}"}
    proc = running(app)
    if proc:
        proc.terminate()
        log(f"closing {app}")
    return 200, {"ok": True}


def type_input(body: dict) -> tuple[int, dict]:
    if isinstance(body.get("text"), str) and body["text"]:
        cmd = ["xdotool", "type", "--delay", "0", "--", body["text"]]
    elif body.get("key") in KEYS:
        cmd = ["xdotool", "key", "--", body["key"]]
    else:
        return 400, {"error": "need text or a known key"}
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        return 500, {"error": r.stderr.strip()}
    return 200, {"ok": True}


class Handler(BaseHTTPRequestHandler):
    def _json(self, code: int, obj) -> None:
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _body(self) -> dict:
        try:
            n = int(self.headers.get("Content-Length", "0"))
            data = json.loads(self.rfile.read(n) if 0 < n <= 4096 else b"{}")
            return data if isinstance(data, dict) else {}
        except ValueError:
            return {}

    def do_GET(self) -> None:
        path = self.path.split("?", 1)[0]
        if path == "/keyboard":
            self._json(200, STATE.keyboard())
        elif path == "/apps":
            self._json(200, {name: {"running": running(name) is not None} for name in APPS})
        else:
            self._json(404, {"error": "not found"})

    def do_POST(self) -> None:
        path = self.path.split("?", 1)[0]
        body = self._body()
        if path == "/launch":
            self._json(*launch(str(body.get("app", ""))))
        elif path == "/close":
            self._json(*close(str(body.get("app", ""))))
        elif path == "/home":
            go_home()
            self._json(200, {"ok": True})
        elif path == "/keyboard":
            STATE.set_keyboard(bool(body.get("visible")))
            self._json(200, STATE.keyboard())
        elif path == "/type":
            self._json(*type_input(body))
        else:
            self._json(404, {"error": "not found"})

    def log_message(self, *_args) -> None:
        pass


def enable_accessibility() -> None:
    """Tell apps an assistive technology is listening (like GNOME's switch)."""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        bus.call_sync(
            "org.a11y.Bus", "/org/a11y/bus", "org.freedesktop.DBus.Properties", "Set",
            GLib.Variant("(ssv)", ("org.a11y.Status", "IsEnabled", GLib.Variant("b", True))),
            None, Gio.DBusCallFlags.NONE, 2000, None,
        )
    except GLib.Error as err:
        log(f"cannot enable accessibility: {err.message}")


def on_focus(event) -> None:
    if event.detail1 != 1:
        return  # the next focus gain decides
    acc = event.source
    try:
        states = acc.get_state_set()
        editable = states.contains(Atspi.StateType.EDITABLE) and not states.contains(Atspi.StateType.READ_ONLY)
        top = False
        if editable:
            ext = acc.get_extents(Atspi.CoordType.SCREEN)
            screen_h = int(os.environ.get("THOR_BOTTOM_HEIGHT", "1080"))
            top = ext.y + ext.height / 2 > screen_h * 0.5
    except GLib.Error:
        return
    if editable != STATE.keyboard()["visible"] or (editable and top != STATE.keyboard()["top"]):
        log(f"text focus {'in' if editable else 'out'}{' (lower half)' if editable and top else ''}")
    STATE.set_keyboard(editable, top)


def main() -> None:
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    enable_accessibility()
    Atspi.init()
    listener = Atspi.EventListener.new(on_focus)
    listener.register("object:state-changed:focused")
    def home_request_stamp() -> int | None:
        try:
            return os.stat(HOME_REQUEST).st_mtime_ns
        except OSError:
            return None

    last_home = home_request_stamp()

    def watch() -> bool:
        nonlocal last_home
        # The keyboard window appears shortly after we start; mark it then,
        # so gamescope does not take it for an app.
        if not STATE.overlay_marked:
            mark_keyboard_overlay(quiet=True)
        # An app ending means its fields are gone too.
        for name, proc in list(STATE.apps.items()):
            if proc.poll() is not None:
                log(f"{name} exited")
                del STATE.apps[name]
                STATE.set_keyboard(False)
        # AYN held: home.
        stamp = home_request_stamp()
        if stamp != last_home:
            last_home = stamp
            if stamp is not None:
                go_home()
        # Overlays draw above the dashboard: step aside while it is up.
        if STATE.keyboard()["visible"] and dashboard_up():
            STATE.set_keyboard(False)
        return True
    GLib.timeout_add(200, watch)
    Atspi.event_main()


if __name__ == "__main__":
    main()
