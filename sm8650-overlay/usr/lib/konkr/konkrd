def set_ioprio(pid: int, level: int) -> None:
    _libc.syscall(SYS_IOPRIO_SET, IOPRIO_WHO_PROCESS, pid, (IOPRIO_CLASS_BE << 13) | level)
PROFILE_RGB = {"silent": (0, 90, 255), "balanced": (0, 255, 60), "turbo": (255, 30, 0)}

