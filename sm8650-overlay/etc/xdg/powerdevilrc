# KONKR Pocket FIT: pbosd owns the power button in both modes, like
# powerbuttond on the Deck (short press sleeps, long press opens the shut
# down prompt), so Plasma must not act on it too.
[AC][SuspendAndShutdown]
AutoSuspendAction=0
PowerButtonAction=0

[Battery][SuspendAndShutdown]
AutoSuspendAction=0
PowerButtonAction=0

[LowBattery][SuspendAndShutdown]
AutoSuspendAction=0
PowerButtonAction=0

[BatteryManagement]
BatteryCriticalAction=0
